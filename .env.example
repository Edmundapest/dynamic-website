# Copy this file to .env for local development, and set the same key in the
# Render dashboard (Settings -> Environment) for production.
#
# Get this from Neon: Project -> Dashboard -> Connection string -> "Pooled connection".
# It looks like:
# postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# --- AI enrichment (DeepSeek, OpenAI-compatible) ---
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Optional overrides:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --- Web search (optional but recommended) ---
# Tavily free tier (1,000 searches/month, no card): https://tavily.com
# Without it, a key-less DuckDuckGo scrape is used (works locally, unreliable
# from datacenter hosts).
TAVILY_API_KEY=

# Where results should point. Without SEARCH_COUNTRY, a vague query like
# "things to do on this weekend" comes back with US results.
# SEARCH_COUNTRY is a Tavily country name (lowercase, e.g. malaysia, singapore).
# SEARCH_LOCATION is appended to queries that only make sense next to a place
# ("near me", "this weekend", "open now", restaurants, clinics...).
# SEARCH_REGION is the DuckDuckGo fallback's region code (`my-en` = Malaysia/English).
# SEARCH_LANGUAGE boosts results in that language (ISO 639-1).
SEARCH_COUNTRY=malaysia
SEARCH_LOCATION=Kuala Lumpur
SEARCH_REGION=my-en
SEARCH_LANGUAGE=en

# --- Card images (optional) ---
# Free Cloudflare Workers AI (no credit card). Get your Account ID and create an
# API token with "Workers AI" permission at https://dash.cloudflare.com.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Alternatives (only if you prefer them):
# TOGETHER_API_KEY=
# HF_TOKEN=

# --- Web Push (notifications) ---
# VAPID key pair used to sign web-push messages. Generate once with:
#   npx web-push generate-vapid-keys
# Reusing the same pair keeps existing subscriptions valid across deploys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service; "mailto:you@example.com" or an https URL.
VAPID_SUBJECT=mailto:admin@example.com

# --- WhatsApp Cloud API (optional) ---
# Post to the wall by messaging a WhatsApp business number, and get the AI card
# back in the chat. Meta app dashboard -> WhatsApp -> API Setup / Configuration.
# Permanent System User token (not the 24-hour test token):
WHATSAPP_TOKEN=
# The "Phone number ID" of the sending number (not the phone number itself):
WHATSAPP_PHONE_NUMBER_ID=
# Random string you also paste into Meta's webhook setup ("Verify token"):
WHATSAPP_VERIFY_TOKEN=
# Meta app -> Settings -> Basic -> App secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Only these senders may post. Comma-separated E.164 digits, no "+" or spaces.
# Example: WHATSAPP_ALLOWED_NUMBERS=15551234567,447700900123
WHATSAPP_ALLOWED_NUMBERS=
# Optional Graph API version (Meta deprecates old versions):
# WHATSAPP_API_VERSION=v23.0
# Optional: link back to the wall in replies. Render sets RENDER_EXTERNAL_URL.
# PUBLIC_URL=https://your-domain.example

# --- WhatsApp setup helper (not used at runtime) ---
# Only needed by `npm run whatsapp:setup`, which can set the Render env vars,
# deploy, verify the callback, and configure the Meta webhook for you.
# Meta app id (App settings -> Basic).
# WHATSAPP_APP_ID=
# WhatsApp Business Account id (WhatsApp Manager -> Account overview).
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# Render Account Settings -> API Keys.
# RENDER_API_KEY=
# Optional: the Render service id (srv-...); otherwise found by name.
# RENDER_SERVICE_ID=

# --- Wall auth ---
# The shared password required to post (viewers don't need it).
POST_PASSWORD=
# Random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Render injects PORT automatically in production. Locally we default to 3000.
# PORT=3000
